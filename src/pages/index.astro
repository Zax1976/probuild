---
import SiteLayout from '../layouts/SiteLayout.astro';
import NamePreview from '../components/NamePreview.astro';
import RateSheet from '../components/RateSheet.astro';
import WorkCard from '../components/WorkCard.astro';
import ShorelineMap from '../components/ShorelineMap.astro';
import { clientSites } from '../data/work';
import { towns } from '../data/towns';

const title = 'Web Design in Ashtabula, Ohio | Pro Build Digital';
const description =
  'Websites for small businesses in Ashtabula County, Ohio, with clear prices and real examples. Built by Zack Pearson in Saybrook.';

const townPages = towns.filter((t) => t.page);
---

<SiteLayout title={title} description={description}>
  <section class="hero surface-dark">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <h1 class="display-1">Websites for small businesses in Ashtabula County</h1>
        <p class="lead hero__lead">
          I'm Zack Pearson, and I build websites for local businesses from Saybrook. You work with me directly, from
          the first email to the day your site goes live.
        </p>
        <p class="hero__found">
          <svg viewBox="0 0 20 20" aria-hidden="true"
            ><circle cx="8.5" cy="8.5" r="5.75" fill="none" stroke="currentColor" stroke-width="1.6"></circle><path
              d="M12.8 12.8l4.4 4.4"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"></path></svg
          >
          <span>Every site is built to show up in Google searches and in AI answers like ChatGPT.</span>
        </p>
        <div class="actions">
          <a href="/start/" class="btn btn--brass">Start a project</a>
          <a href="/pricing/" class="btn btn--line">See prices</a>
        </div>
        <a href="#sample-site" class="text-link hero__try">See a sample site with your business name</a>
      </div>

      <div class="hero__demo">
        <NamePreview />
      </div>
    </div>
  </section>

  <section class="section surface-white" aria-labelledby="prices-title">
    <div class="wrap">
      <div class="section-head section-head--split">
        <h2 id="prices-title" class="display-2">What it costs</h2>
        <p class="lead muted">
          Two ways to get a site built, and a monthly plan if you want me to keep it running. You see the price before
          any work starts.
        </p>
      </div>
      <RateSheet />
      <p class="rates-more">
        <a href="/pricing/" class="text-link">See what each package includes and leaves out</a>
      </p>
    </div>
  </section>

  <section class="section surface-light" aria-labelledby="work-title">
    <div class="wrap">
      <div class="section-head section-head--split">
        <h2 id="work-title" class="display-2">Recent work</h2>
        <p class="lead muted">Both sites are live. Open them on your phone and click around.</p>
      </div>
      <div class="work-grid">
        {clientSites.map((s) => <WorkCard site={s} />)}
      </div>
      <p class="rates-more">
        <a href="/work/" class="text-link">See all work, including the products I run</a>
      </p>
    </div>
  </section>

  <section class="section surface-white" aria-labelledby="how-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="how-title" class="display-2">How it works</h2>
      </div>
      <ol class="steps">
        <li>
          <h3 class="display-3">You fill out the form</h3>
          <p class="prose-text muted">Tell me about your business and what you need. It takes a few minutes.</p>
        </li>
        <li>
          <h3 class="display-3">I email a quote</h3>
          <p class="prose-text muted">
            Within one business day you get a price and a few questions about your business.
          </p>
        </li>
        <li>
          <h3 class="display-3">I build, you review, it goes live</h3>
          <p class="prose-text muted">You see the whole site and ask for changes before it goes live.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="surface-dark map-section" aria-labelledby="where-title">
    <ShorelineMap variant="band">
      <h2 id="where-title" class="display-2">From Painesville to Conneaut</h2>
      <p class="lead map-section__lead">
        I'm based in Saybrook and work with businesses across Ashtabula County and nearby towns in Lake County.
      </p>
      <ul class="map-section__links">
        {
          townPages.map((t) => (
            <li>
              <a href={t.page} class="text-link">
                Web design in {t.name}
              </a>
            </li>
          ))
        }
      </ul>
    </ShorelineMap>
  </section>

  <section class="section surface-light" aria-labelledby="cta-title">
    <div class="wrap cta">
      <h2 id="cta-title" class="display-2">Tell me about your business</h2>
      <div class="cta__body">
        <p class="lead">
          Fill out a short form and I'll email you a quote and a few questions within one business day.
        </p>
        <div class="actions">
          <a href="/start/" class="btn btn--ink">Start a project</a>
          <span class="muted small">No sales calls unless you ask for one.</span>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .hero {
    padding: clamp(48px, 6vw, 88px) 0 clamp(72px, 8vw, 120px);
    overflow: hidden;
  }

  .hero__grid {
    display: grid;
    gap: 56px;
  }

  @media (min-width: 1100px) {
    .hero__grid {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
      gap: clamp(48px, 5vw, 88px);
      align-items: center;
    }
  }

  .hero__demo {
    min-width: 0;
  }

  .hero__copy {
    display: grid;
    gap: 28px;
    align-content: start;
  }

  .hero__copy .display-1 {
    color: #f6f3ea;
    max-width: 11.5em;
  }

  .hero__lead {
    color: var(--cream);
  }

  .hero__try {
    justify-self: start;
    margin-top: -6px;
    color: var(--cream);
    font-weight: 600;
  }

  .hero__found {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin: 0;
    max-width: 30rem;
    padding: 16px 0 0;
    border-top: 1px solid var(--lake-line);
    font-size: 1rem;
    font-weight: 550;
    line-height: 1.5;
    color: var(--cream);
  }

  .hero__found svg {
    width: 20px;
    height: 20px;
    flex: none;
    margin-top: 2px;
    color: var(--brass);
  }

  .rates-more {
    margin: 36px 0 0;
    font-weight: 600;
  }

  .work-grid {
    display: grid;
    gap: 64px;
  }

  @media (min-width: 900px) {
    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(40px, 4vw, 64px);
    }
  }

  .map-section {
    overflow: hidden;
  }

  .map-section__lead {
    margin-top: 18px;
    color: var(--cream);
  }

  .map-section__links {
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    font-weight: 600;
  }

  .map-section__links a {
    color: var(--cream);
  }

  .cta {
    display: grid;
    gap: 28px;
  }

  @media (min-width: 900px) {
    .cta {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 64px;
      align-items: end;
    }
  }

  .cta__body {
    display: grid;
    gap: 26px;
  }
</style>
