<style>
  .legal-content {
    color: #334155;
    line-height: 1.75;
    font-size: 1rem;
  }
  .legal-content h2 {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: #0d1b2a;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #e2e8f0;
    letter-spacing: -0.01em;
  }
  .legal-content p {
    margin-bottom: 1rem;
  }
  .legal-content ul {
    list-style: disc;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }
  .legal-content ul li {
    margin-bottom: 0.5rem;
  }
  .legal-content strong {
    color: #0d1b2a;
    font-weight: 600;
  }
  .legal-content a {
    color: #0891b2;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .legal-content a:hover {
    color: #0e7490;
  }
  .legal-content hr {
    border: none;
    border-top: 1px solid #e2e8f0;
    margin: 2.5rem 0;
  }
  .legal-content .uppercase-block {
    font-size: 0.95rem;
    letter-spacing: 0.015em;
  }
  .legal-meta {
    color: #64748b;
    font-size: 0.95rem;
    margin-bottom: 2rem;
    padding: 1rem 1.25rem;
    background: #f8fafc;
    border-left: 3px solid #06b6d4;
    border-radius: 0.25rem;
  }
