---
import NightshiftLayout from '../layouts/NightshiftLayout.astro';

const pageTitle = 'About Us - Pro Build Digital';
const pageDescription = 'Pro Build Digital: Founded by Zack Pearson to help small businesses and contractors succeed with simple, effective digital solutions.';

// Values data
const values = [
  { title: 'Simple', description: 'Easy to use, no technical knowledge required' },
  { title: 'Fast', description: 'Quick implementation, immediate results' },
  { title: 'Reliable', description: 'Systems that work when you need them' },
  { title: 'Supportive', description: 'Always here to help when you need it' },
];

// Why choose data
const whyChoose = [
  { title: 'We Understand Your Business', description: "We specialize in working with contractors, tradespeople, and service businesses. We know your challenges." },
  { title: 'Mobile-First Approach', description: "Your customers are on their phones. Every solution we build works perfectly on mobile devices." },
  { title: 'Fast Implementation', description: "Most of our solutions are up and running within days, not months, so you can start seeing results immediately." },
  { title: 'Ongoing Support', description: "We provide ongoing maintenance, updates, and support so your digital tools keep working as your business grows." },
  { title: 'Transparent Pricing', description: 'No hidden fees or surprise charges. We tell you exactly what everything costs upfront.' },
  { title: 'Personal Service', description: "When you work with us, you get direct access to real people who understand your business." },
];

// Process steps
const processSteps = [
  { number: '1.', title: 'Discovery Call', description: "Free consultation to understand your business, challenges, and goals." },
  { number: '2.', title: 'Custom Solution', description: 'A custom plan that fits your specific needs and budget.' },
  { number: '3.', title: 'Quick Implementation', description: 'Most projects are completed and live within 1-2 weeks.' },
  { number: '4.', title: 'Training & Support', description: "We ensure you're comfortable and provide ongoing support." },
];

// Credentials
const credentials = [
  { title: 'MBA + 19 Years Experience', description: 'Jack Welch Management Institute, Verizon Operations' },
  { title: 'Certified Project Manager', description: 'Scrum Master, Product Owner, ISTQB Certified' },
  { title: 'Enterprise Systems Expert', description: 'Revenue assurance, billing systems, automation' },
];
---

<NightshiftLayout title={pageTitle} description={pageDescription}>
  <!-- Hero -->
  <section
    class="relative px-6 md:px-16 pt-[72px] pb-20 text-center"
    style="background: radial-gradient(ellipse 50% 60% at 50% 30%, rgba(200,165,92,0.12) 0%, rgba(14,27,46,0) 70%);"
  >
    <p class="ns-kicker">Our story</p>
    <h1 class="ns-h1 text-[clamp(2.25rem,1.5rem+2.5vw,3.625rem)] leading-[1.08] mt-4 mx-auto max-w-[760px]">
      About Pro Build Digital
    </h1>
    <p class="text-lg leading-[1.65] text-mist mt-[22px] mx-auto max-w-[540px]">
      We're here to make digital simple for small businesses and contractors.
    </p>
  </section>

  <!-- Mission -->
  <section class="px-6 md:px-16 pb-24">
    <div class="max-w-[1312px] mx-auto">
      <div class="border-t border-cream/10 pt-[72px] grid lg:grid-cols-2 gap-12 lg:gap-[72px] items-center">
        <div>
          <p class="ns-kicker">Our mission</p>
          <h2 class="ns-h2 mt-4">Professional digital tools without the complexity.</h2>
          <p class="text-[17px] leading-[1.65] text-mist mt-[22px]">
            We believe that every small business deserves access to professional digital tools without the complexity, high costs, or technical headaches that usually come with them.
          </p>
          <p class="text-[15.5px] leading-[1.65] text-mist mt-4">
            Most small business owners didn't get into business to become tech experts. They got into business to provide great service, build things, and solve problems.
          </p>
          <p class="text-[15.5px] leading-[1.65] text-mist mt-4">
            That's why we create digital solutions that work seamlessly in the background, letting you focus on what you do best.
            <span class="font-semibold text-cream">No confusing jargon. No overcomplicated systems. Just simple, effective tools.</span>
          </p>
        </div>

        <!-- Values Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {values.map((value) => (
            <div class="bg-night-surface border border-cream/15 rounded-[14px] px-[26px] py-[22px]">
              <h3 class="font-serif-display text-[19px] text-cream-bright">{value.title}</h3>
              <p class="text-[14.5px] leading-[1.65] text-mist mt-2">{value.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Founder -->
  <section class="px-6 md:px-16 pb-24">
    <div class="max-w-[1312px] mx-auto">
      <div class="border-t border-cream/10 pt-[72px] grid lg:grid-cols-3 gap-12 items-start">
        <!-- Photo -->
        <div class="flex justify-center lg:justify-start">
          <img
            src="https://i.imgur.com/N9QBKHN.jpg"
            alt="Zack Pearson - Founder of Pro Build Digital"
            class="w-48 h-48 rounded-full object-cover border border-brass/25 shadow-[0_0_60px_rgba(200,165,92,0.15)]"
            loading="lazy"
          >
        </div>

        <!-- Bio -->
        <div class="lg:col-span-2">
          <p class="ns-kicker">Meet the founder</p>
          <h2 class="ns-h2 mt-4">Zack Pearson</h2>
          <p class="text-[15px] text-faint font-medium mt-2">Founder &amp; Lead Digital Solutions Architect</p>

          <p class="text-[15.5px] leading-[1.65] text-mist mt-5">
            With over 19 years of experience in operations, project management, and systems optimization at Verizon Communications, I understand what it takes to build digital solutions that actually work for business.
          </p>
          <p class="text-[15.5px] leading-[1.65] text-mist mt-4">
            I've spent two decades perfecting complex billing systems, managing multi-million dollar projects, and ensuring 99.9% accuracy in mission-critical operations. Now I'm bringing that same level of precision and reliability to small businesses.
          </p>

          <!-- Credentials -->
          <div class="grid sm:grid-cols-3 gap-4 mt-8">
            {credentials.map((cred) => (
              <div class="bg-night-surface border border-cream/15 rounded-[14px] px-5 py-4">
                <h4 class="font-sans font-bold text-[14.5px] text-cream">{cred.title}</h4>
                <p class="text-[12.5px] leading-normal text-faint mt-1.5">{cred.description}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose -->
  <section class="px-6 md:px-16 pb-24">
    <div class="max-w-[1312px] mx-auto">
      <div class="border-t border-cream/10 pt-[72px]">
        <p class="ns-kicker">Why us</p>
        <h2 class="ns-h2 mt-4">Why choose Pro Build Digital?</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4 mt-12">
        {whyChoose.map((item) => (
          <div class="bg-night-surface border border-cream/15 rounded-[14px] px-[26px] py-[22px]">
            <h3 class="font-sans font-bold text-[17px] text-cream">{item.title}</h3>
            <p class="text-[15px] leading-[1.65] text-mist mt-2">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="px-6 md:px-16 pb-24">
    <div class="max-w-[1312px] mx-auto">
      <div class="border-t border-cream/10 pt-[72px]">
        <p class="ns-kicker">Our process</p>
        <h2 class="ns-h2 mt-4">How we work.</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 mt-12">
        {processSteps.map((step) => (
          <div>
            <div class="font-serif-display italic text-[44px] text-brass leading-none">{step.number}</div>
            <h3 class="font-sans font-bold text-[19px] text-cream mt-[18px] mb-2.5">{step.title}</h3>
            <p class="text-[15px] leading-[1.65] text-mist">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section
    class="px-6 md:px-16 py-24 border-t border-cream/10 text-center"
    style="background: radial-gradient(ellipse 50% 60% at 50% 30%, rgba(200,165,92,0.12) 0%, rgba(14,27,46,0) 70%);"
  >
    <p class="ns-kicker">The next step</p>
    <h2 class="ns-h2 mt-4 mx-auto max-w-[760px]">Ready to work together?</h2>
    <p class="text-lg leading-[1.65] text-mist mt-[22px] mx-auto max-w-[540px]">
      Let's have a conversation about how we can help your business grow with the right digital tools.
    </p>
    <div class="flex items-center justify-center mt-[38px]">
      <a href="/contact" class="btn-brass px-10 py-[17px]">Get your free consultation</a>
    </div>
  </section>
</NightshiftLayout>

<!-- n8n Chat Widget - Deferred for performance -->
<script>
  window.addEventListener('load', function() {
    setTimeout(function() {
      var link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = 'https://cdn.jsdelivr.net/npm/@n8n/chat/dist/style.css';
      document.head.appendChild(link);
      import('https://cdn.jsdelivr.net/npm/@n8n/chat/dist/chat.bundle.es.js')
        .then(function(module) {
          module.createChat({
            webhookUrl: 'https://zax76.app.n8n.cloud/webhook/2610f1f4-f38d-4b33-ba97-da199e6a15bc/chat',
            mode: 'window', loadPreviousSession: false,
            initialMessages: ['Welcome to Pro Build Digital!', 'What can I help you with today?'],
            i18n: { en: { title: 'BuildBot', subtitle: 'Digital Solutions Assistant', getStarted: 'Start Chat' }},
            showWelcomeScreen: false,
            theme: { header: { background: '#0E1B2E', color: '#EAE6DA' }, button: { background: '#0E1B2E', color: '#EAE6DA' }}
          });
        });
    }, 3000);
  });
</script>
