---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import zack from '../assets/people/zack-pearson.jpg';
import { site } from '../data/site';

const title = 'About Zack Pearson, Web Designer in Saybrook, Ohio | Pro Build Digital';
const description =
  'Zack Pearson builds websites for small businesses in Ashtabula County from Saybrook, Ohio. You work with him directly, from the first email to launch day.';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.owner,
  jobTitle: 'Web designer',
  worksFor: { '@id': `${site.url}/#business` },
  homeLocation: { '@type': 'Place', name: 'Saybrook, Ohio' },
  sameAs: [site.linkedIn],
};
---

<SiteLayout title={title} description={description}>
  <PageHero
    title="I'm Zack Pearson, a web designer in Saybrook, Ohio"
    lead="I build websites for small businesses in Ashtabula County. I do the work myself, so you work with me directly from the first email to launch day."
  >
    <Fragment slot="aside">
      <figure class="portrait">
        <Image src={zack} alt="Zack Pearson" widths={[240, 360, 480]} sizes="(min-width: 1000px) 360px, 60vw" />
        <figcaption><span class="todo">Confirm this photo or swap in a new one</span></figcaption>
      </figure>
    </Fragment>
  </PageHero>

  <section class="section surface-light" aria-labelledby="story-title">
    <div class="wrap about">
      <h2 id="story-title" class="display-2">How I got here</h2>
      <div class="prose-text">
        <p>Before I started Pro Build Digital, I spent 19 years at Verizon in project management and operations.</p>
        <p>
          I also build and run a few products of my own, including KeptPages and Cottages Concierge. You can see them
          on the <a href="/work/" class="text-link">work page</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section surface-white" aria-labelledby="creds-title">
    <div class="wrap about">
      <h2 id="creds-title" class="display-2">Certifications</h2>
      <ul class="creds">
        <li>
          <h3>Certified Scrum Master</h3>
          <p>Training in running a project in short, planned steps with regular check-ins.</p>
        </li>
        <li>
          <h3>Certified Scrum Product Owner</h3>
          <p>Training in deciding what gets built first and why.</p>
        </li>
        <li>
          <h3>ISTQB certified</h3>
          <p>A certification in software testing.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section surface-light" aria-labelledby="work-with-title">
    <div class="wrap about">
      <h2 id="work-with-title" class="display-2">Working with me</h2>
      <ul class="points">
        <li>You deal with one person, start to finish.</li>
        <li>I reply by email within one business day.</li>
        <li>You see the price before any work starts.</li>
        <li>No sales calls unless you ask for one.</li>
      </ul>
    </div>
  </section>

  <CtaBand />

  <script slot="head" type="application/ld+json" set:html={JSON.stringify(personSchema)} />
</SiteLayout>

<style>
  .portrait {
    margin: 0;
    display: grid;
    gap: 12px;
    justify-items: start;
    max-width: 360px;
  }

  .portrait img {
    width: 100%;
    height: auto;
    border-radius: 10px;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .about {
    display: grid;
    gap: 28px;
  }

  @media (min-width: 1000px) {
    .about {
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
      gap: 64px;
      align-items: start;
    }
  }

  .creds {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--lake);
  }

  .creds li {
    display: grid;
    gap: 6px;
    padding: 20px 0;
    border-bottom: 1px solid var(--rule);
  }

  .creds h3 {
    margin: 0;
    font-size: 1.1875rem;
    font-weight: 700;
  }

  .creds p {
    margin: 0;
    font-family: var(--font-text);
    font-size: 1.125rem;
    color: var(--ink-2);
  }

  .points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    border-top: 2px solid var(--lake);
  }

  .points li {
    padding: 18px 0;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-text);
    font-size: 1.25rem;
    line-height: 1.45;
  }
</style>
