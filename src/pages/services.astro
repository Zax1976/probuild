---
import NightshiftLayout from '../layouts/NightshiftLayout.astro';

const pageTitle = 'The Build Bot & Services - Pro Build Digital';
const pageDescription = 'The Build Bot answers for your business 24/7 and captures leads. Pro Build Digital also builds websites, automation, and digital invoicing for small businesses.';

// Services data - the Build Bot leads; agency services follow.
// Anchor ids are kept: other pages link to /services#<id>.
const services = [
  {
    id: 'ai-chatbots',
    number: '1.',
    title: 'The Build Bot',
    description: "Never miss a customer inquiry again. The Build Bot answers for your business 24/7, handles the common questions, and captures leads while you're busy working. You name it and brand it as your own.",
    features: [
      '24/7 automated customer support',
      'Common question answering',
      'Lead capture and qualification',
      'Appointment scheduling',
      'Custom responses for your business',
      'Integration with your website',
      'Performance analytics',
    ],
    perfectFor: "Busy contractors who can't always answer the phone, service businesses with common customer questions, and anyone who wants to capture leads 24/7.",
  },
  {
    id: 'website-development',
    number: '2.',
    title: 'Website Development',
    description: 'Get a professional website that works on all devices and brings in customers. We build fast, mobile-friendly websites that showcase your work and make it easy for customers to contact you.',
    features: [
      'Mobile-responsive design',
      'Fast loading times (under 3 seconds)',
      'SEO optimization for Google',
      'Contact forms and lead capture',
      'Photo galleries for your work',
      'Easy content updates',
      'SSL security certificate',
    ],
    perfectFor: 'Contractors, plumbers, electricians, landscapers, and any service-based business that needs a professional online presence.',
  },
  {
    id: 'automation',
    number: '3.',
    title: 'Automation',
    description: "Save hours every week with automated workflows. From invoicing to customer follow-ups, we'll automate the repetitive tasks so you can focus on what you do best.",
    features: [
      'Automated invoicing and billing',
      'Customer follow-up sequences',
      'Appointment scheduling automation',
      'Email marketing campaigns',
      'Payment reminders',
      'Lead nurturing workflows',
      'Custom automation setup',
    ],
    perfectFor: 'Small business owners who want to streamline their operations, reduce manual work, and improve customer communication.',
  },
  {
    id: 'digital-invoicing',
    number: '4.',
    title: 'Digital Invoicing',
    description: 'Get paid faster with professional digital invoices. Our system creates, sends, and tracks invoices automatically, with payment reminders that actually work.',
    features: [
      'Professional invoice design',
      'Automated invoice generation',
      'Online payment processing',
      'Automatic payment reminders',
      'Payment tracking and reporting',
      'Tax-ready financial reports',
      'Integration with accounting software',
    ],
    perfectFor: 'Contractors and service providers who want to get paid faster, reduce paperwork, and have better control over their cash flow.',
  },
];
---

<NightshiftLayout title={pageTitle} description={pageDescription}>
  <!-- Hero -->
  <section
    class="relative px-6 md:px-16 pt-[72px] pb-20 text-center"
    style="background: radial-gradient(ellipse 50% 60% at 50% 30%, rgba(200,165,92,0.12) 0%, rgba(14,27,46,0) 70%);"
  >
    <p class="ns-kicker">What we offer</p>
    <h1 class="ns-h1 text-[clamp(2.25rem,1.5rem+2.5vw,3.625rem)] leading-[1.08] mt-4 mx-auto max-w-[760px]">
      The Build Bot, and the tools around it.
    </h1>
    <p class="text-lg leading-[1.65] text-mist mt-[22px] mx-auto max-w-[540px]">
      The Build Bot is the flagship. Websites, automation, and invoicing round it out, built the
      same way: simple, fast, and made for small businesses.
    </p>
  </section>

  <!-- Services Detailed -->
  <section class="px-6 md:px-16 pb-24">
    <div class="max-w-[1312px] mx-auto">
      {services.map((service) => (
        <div id={service.id} class="border-t border-cream/10 py-[72px] scroll-mt-24">
          <div class="grid lg:grid-cols-2 gap-12 lg:gap-[72px] items-start">
            <div>
              <div class="font-serif-display italic text-[44px] text-brass leading-none">{service.number}</div>
              <h2 class="ns-h2 mt-4">{service.title}</h2>
              <p class="text-[17px] leading-[1.65] text-mist mt-[22px]">{service.description}</p>

              <div class="bg-night-surface border border-cream/15 rounded-[14px] px-[26px] py-[22px] mt-8">
                <h3 class="font-sans font-bold text-[17px] text-cream">Perfect for</h3>
                <p class="text-[15px] leading-[1.65] text-mist mt-2">{service.perfectFor}</p>
              </div>
            </div>

            <div>
              <h3 class="font-sans font-bold text-[17px] text-cream lg:mt-[60px]">What's included</h3>
              <div class="flex flex-col border border-cream/15 rounded-[14px] overflow-hidden mt-4">
                {service.features.map((feature) => (
                  <div class="flex items-center gap-3 px-[22px] py-[13px] bg-night-surface border-b border-cream/10 last:border-b-0">
                    <span class="text-brass" aria-hidden="true">&#10003;</span>
                    <span class="text-[15px] text-mist">{feature}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section
    class="px-6 md:px-16 py-24 border-t border-cream/10 text-center"
    style="background: radial-gradient(ellipse 50% 60% at 50% 30%, rgba(200,165,92,0.12) 0%, rgba(14,27,46,0) 70%);"
  >
    <p class="ns-kicker">The next step</p>
    <h2 class="ns-h2 mt-4 mx-auto max-w-[760px]">See it working for your business.</h2>
    <p class="text-lg leading-[1.65] text-mist mt-[22px] mx-auto max-w-[540px]">
      Book a 15-minute demo of the Build Bot, or tell us what your business needs and we'll put
      together a plain-numbers plan.
    </p>
    <div class="flex items-center justify-center gap-7 mt-[38px] flex-wrap">
      <a href="/#demo" class="btn-brass px-10 py-[17px]">Book a demo</a>
      <a href="/contact" class="inline-flex items-center min-h-11 text-[15px] text-mist transition-colors">
        <span class="border-b border-brass/50 pb-0.5">Contact us</span>
      </a>
    </div>
  </section>
</NightshiftLayout>

<!-- n8n Chat Widget - Deferred for performance -->
<script>
  window.addEventListener('load', function() {
    setTimeout(function() {
      var link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = 'https://cdn.jsdelivr.net/npm/@n8n/chat/dist/style.css';
      document.head.appendChild(link);
      import('https://cdn.jsdelivr.net/npm/@n8n/chat/dist/chat.bundle.es.js')
        .then(function(module) {
          module.createChat({
            webhookUrl: 'https://zax76.app.n8n.cloud/webhook/2610f1f4-f38d-4b33-ba97-da199e6a15bc/chat',
            mode: 'window', loadPreviousSession: false,
            initialMessages: ['Welcome to Pro Build Digital! I\'m here to help with your digital needs.', 'What can I help you with today?'],
            i18n: { en: { title: 'BuildBot', subtitle: 'Digital Solutions Assistant', footer: '', getStarted: 'Start Chat', inputPlaceholder: 'Type your message here...' } },
            showWelcomeScreen: false,
            theme: { header: { background: '#0E1B2E', color: '#EAE6DA' }, button: { background: '#0E1B2E', color: '#EAE6DA' } }
          });
        });
    }, 3000);
  });
</script>
