---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';

const title = 'Page Not Found | Pro Build Digital';
const description = 'This page is not here. Try the home page, prices or recent work.';
---

<SiteLayout title={title} description={description} noindex>
  <PageHero title="This page isn't here" lead="It may have moved, or the link may have a typo. These pages are a good place to start.">
    <ul class="lost">
      <li><a href="/" class="btn btn--brass">Home</a></li>
      <li><a href="/pricing/" class="btn btn--line">Prices</a></li>
      <li><a href="/work/" class="btn btn--line">Work</a></li>
      <li><a href="/start/" class="btn btn--line">Start a project</a></li>
    </ul>
  </PageHero>
</SiteLayout>

<style>
  .lost {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
  }
</style>
