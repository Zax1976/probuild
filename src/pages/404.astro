---
import NightshiftLayout from '../layouts/NightshiftLayout.astro';

const pageTitle = '404 - Page Not Found | Pro Build Digital';
const pageDescription = 'The page you are looking for could not be found. Return to Pro Build Digital homepage.';
---

<NightshiftLayout title={pageTitle} description={pageDescription}>
  <section class="min-h-[70vh] flex items-center justify-center px-6 md:px-16 py-20">
    <div class="max-w-2xl mx-auto text-center">
      <p class="ns-kicker">Wrong turn</p>
      <h1 class="ns-h1 mt-4">404</h1>
      <h2 class="font-serif-display text-2xl md:text-3xl text-cream mt-4 mb-6">Page not found</h2>
      <p class="text-lg text-mist mb-10 leading-relaxed">
        Oops! The page you're looking for doesn't exist or has been moved.
        Don't worry, let's get you back on track.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="btn-brass">Go to Homepage</a>
        <a
          href="/contact"
          class="inline-block px-[34px] py-4 rounded-lg border border-cream/25 text-cream font-wordmark font-bold hover:border-brass hover:text-brass transition-colors"
        >
          Contact Us
        </a>
      </div>

      <div class="mt-14 text-faint">
        <p class="mb-4">Or try one of these popular pages:</p>
        <div class="flex flex-wrap gap-x-6 gap-y-2 justify-center">
          <a href="/services" class="inline-flex items-center min-h-11 text-mist underline underline-offset-4 decoration-cream/25 transition-colors">The Build Bot</a>
          <a href="/about" class="inline-flex items-center min-h-11 text-mist underline underline-offset-4 decoration-cream/25 transition-colors">About Us</a>
          <a href="/blog" class="inline-flex items-center min-h-11 text-mist underline underline-offset-4 decoration-cream/25 transition-colors">Blog</a>
        </div>
      </div>
    </div>
  </section>
</NightshiftLayout>
