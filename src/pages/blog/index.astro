---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection } from 'astro:content';

const title = 'Blog | Pro Build Digital';
const description =
  'Notes on websites, search and getting found online, written for small business owners by Zack Pearson.';

const posts = (await getCollection('blog', ({ data }) => data.draft !== true)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<SiteLayout title={title} description={description}>
  <PageHero title="Blog" lead="Notes on websites, search and getting found online, written for small business owners." />

  <section class="section surface-light">
    <div class="wrap">
      <ol class="posts">
        {
          posts.map((post) => (
            <li class="post">
              <time datetime={post.data.date.toISOString()} class="post__date">
                {formatDate(post.data.date)}
              </time>
              <div class="post__body">
                <h2 class="display-3">
                  <a href={`/blog/${post.slug}/`} class="post__link">
                    {post.data.title}
                  </a>
                </h2>
                <p class="prose-text muted">{post.data.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaBand />
</SiteLayout>

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--lake);
  }

  .post {
    display: grid;
    gap: 10px 48px;
    padding: 28px 0;
    border-bottom: 1px solid var(--rule);
  }

  @media (min-width: 860px) {
    .post {
      grid-template-columns: 12rem minmax(0, 1fr);
    }
  }

  .post__date {
    padding-top: 6px;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .post__body {
    display: grid;
    gap: 10px;
  }

  .post__body h2,
  .post__body p {
    margin: 0;
  }

  .post__link {
    color: var(--ink);
    text-decoration: none;
  }

  .post__link:hover {
    text-decoration: underline;
    text-decoration-color: var(--brass-ink);
    text-underline-offset: 0.18em;
  }
</style>
