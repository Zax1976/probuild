---
import NightshiftLayout from '../../layouts/NightshiftLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// Format date helper
function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}

// Article Schema
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": post.data.date.toISOString(),
  "author": {
    "@type": "Person",
    "name": post.data.author
  },
  "publisher": {
    "@type": "Organization",
    "name": "Pro Build Digital",
    "logo": {
      "@type": "ImageObject",
      "url": "https://probuilddigital.com/images/logo.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://probuilddigital.com/blog/${post.slug}`
  }
};
---

<NightshiftLayout
  title={`${post.data.title} - Pro Build Digital Blog`}
  description={post.data.description}
  ogImage={post.data.image}
>
  <article>
    <!-- Article Header -->
    <header class="px-6 md:px-16 pt-20 pb-12 border-b border-cream/10">
      <div class="max-w-3xl mx-auto">
        <!-- Meta Info -->
        <div class="flex flex-wrap items-center gap-4 text-sm text-faint mb-6">
          <time datetime={post.data.date.toISOString()} class="flex items-center gap-1.5">
            <i class="fas fa-calendar text-xs text-brass" aria-hidden="true"></i>
            {formatDate(post.data.date)}
          </time>
          {post.data.readTime && (
            <span class="flex items-center gap-1.5">
              <i class="fas fa-clock text-xs text-brass" aria-hidden="true"></i>
              {post.data.readTime}
            </span>
          )}
          {post.data.author && (
            <span class="flex items-center gap-1.5">
              <i class="fas fa-user text-xs text-brass" aria-hidden="true"></i>
              {post.data.author}
            </span>
          )}
        </div>

        <!-- Title -->
        <h1 class="ns-h1 text-[clamp(2rem,1.4rem+2.5vw,3.25rem)] leading-[1.12]">
          {post.data.title}
        </h1>

        <!-- Description -->
        <p class="font-serif-display italic text-xl text-mist leading-relaxed mt-6">
          {post.data.description}
        </p>

        <!-- Tags -->
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-8">
            {post.data.tags.map((tag) => (
              <span class="text-sm bg-brass/10 border border-brass/25 text-brass px-3 py-1 rounded-full font-medium">
                {tag}
              </span>
            ))}
          </div>
        )}
      </div>
    </header>

    <!-- Article Content -->
    <div class="px-6 md:px-16 py-16 md:py-20">
      <div class="max-w-3xl mx-auto">
        <div class="ns-prose">
          <Content />
        </div>

        <!-- Author Bio -->
        <div class="mt-16 pt-10 border-t border-cream/10">
          <div class="flex items-start gap-5">
            <img
              src="https://i.imgur.com/N9QBKHN.jpg"
              alt={post.data.author}
              class="w-16 h-16 rounded-full object-cover border-2 border-brass/40"
              loading="lazy"
            >
            <div>
              <h3 class="font-serif-display font-medium text-cream-bright text-lg">{post.data.author}</h3>
              <p class="text-mist text-sm mb-2">Founder &amp; Lead Digital Solutions Architect at Pro Build Digital</p>
              <a href="/about" class="text-brass text-sm font-medium inline-flex items-center gap-1">
                Learn more about Zack
                <i class="fas fa-arrow-right text-xs" aria-hidden="true"></i>
              </a>
            </div>
          </div>
        </div>

        <!-- Back to Blog -->
        <div class="mt-10">
          <a href="/blog" class="inline-flex items-center gap-2 min-h-11 text-mist font-medium transition-colors">
            <i class="fas fa-arrow-left" aria-hidden="true"></i>
            Back to all posts
          </a>
        </div>
      </div>
    </div>
  </article>

  <!-- CTA -->
  <section class="px-6 md:px-16 py-20 bg-night-deep border-t border-cream/10 text-center">
    <p class="ns-kicker">The next step</p>
    <h2 class="ns-h2 mt-4 mx-auto max-w-[760px]">Ready to build your digital foundation?</h2>
    <p class="text-lg text-mist max-w-2xl mx-auto mt-5 mb-9">
      Get a free consultation and see how we can help your business grow with the right digital tools.
    </p>
    <a href="/contact" class="btn-brass px-10 py-[17px]">Get Started</a>
  </section>

  <!-- Article Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
</NightshiftLayout>

<!-- n8n Chat Widget - Deferred for performance -->
<script>
  window.addEventListener('load', function() {
    setTimeout(function() {
      var link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = 'https://cdn.jsdelivr.net/npm/@n8n/chat/dist/style.css';
      document.head.appendChild(link);
      import('https://cdn.jsdelivr.net/npm/@n8n/chat/dist/chat.bundle.es.js')
        .then(function(module) {
          module.createChat({
            webhookUrl: 'https://zax76.app.n8n.cloud/webhook/2610f1f4-f38d-4b33-ba97-da199e6a15bc/chat',
            mode: 'window', loadPreviousSession: false,
            initialMessages: ['Welcome to Pro Build Digital!', 'What can I help you with today?'],
            i18n: { en: { title: 'BuildBot', subtitle: 'Digital Solutions Assistant', getStarted: 'Start Chat' }},
            showWelcomeScreen: false,
            theme: { header: { background: '#0A1422', color: '#EAE6DA' }, button: { background: '#C8A55C', color: '#0E1B2E' }}
          });
        });
    }, 3000);
  });
</script>

<style is:global>
  /* Nightshift long-form prose — Newsreader serif body for reading comfort,
     Hanken for UI-ish fragments. Global (not scoped) because it styles the
     markdown rendered by <Content />. */
  .ns-prose {
    font-family: var(--font-display);
    font-size: 1.1875rem; /* 19px — serif reads smaller than the sans */
    color: var(--text-cream);
    line-height: 1.8;
  }
  .ns-prose h1,
  .ns-prose h2 {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--text-cream-bright);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .ns-prose h1 { font-size: 2rem; line-height: 1.15; }
  .ns-prose h2 { font-size: 1.625rem; line-height: 1.2; }
  .ns-prose h3 {
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text-cream-bright);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .ns-prose p {
    margin-bottom: 1.35rem;
  }
  .ns-prose ul {
    list-style-type: disc;
    padding-left: 1.75rem;
    margin-bottom: 1.35rem;
  }
  .ns-prose ol {
    list-style-type: decimal;
    padding-left: 1.75rem;
    margin-bottom: 1.35rem;
  }
  .ns-prose li {
    margin-bottom: 0.5rem;
  }
  .ns-prose li::marker {
    color: var(--brass);
  }
  .ns-prose blockquote {
    border-left: 3px solid var(--brass);
    font-style: italic;
    margin: 1.75rem 0;
    color: var(--text-mist);
    background: var(--surface);
    padding: 1rem 1.25rem;
    border-radius: 0 0.5rem 0.5rem 0;
  }
  .ns-prose code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.85em;
    background-color: var(--surface);
    border: 1px solid var(--hairline);
    padding: 0.15rem 0.4rem;
    border-radius: 0.375rem;
    color: var(--text-cream-bright);
  }
  .ns-prose pre {
    background-color: var(--bg-deep);
    border: 1px solid var(--hairline);
    color: var(--text-cream);
    padding: 1.25rem;
    border-radius: 0.75rem;
    overflow-x: auto;
    margin: 1.5rem 0;
    font-size: 0.9rem;
  }
  .ns-prose pre code {
    background: none;
    border: none;
    padding: 0;
    color: inherit;
  }
  .ns-prose hr {
    margin: 2.5rem 0;
    border: none;
    border-top: 1px solid var(--hairline);
  }
  .ns-prose a {
    color: var(--brass);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(200, 165, 92, 0.4);
    transition: text-decoration-color 0.2s;
  }
  .ns-prose a:hover {
    text-decoration-color: var(--brass);
  }
  .ns-prose strong {
    font-weight: 600;
    color: var(--text-cream-bright);
  }
  .ns-prose img {
    border-radius: 0.75rem;
    margin: 1.5rem 0;
    border: 1px solid var(--hairline);
  }
</style>
