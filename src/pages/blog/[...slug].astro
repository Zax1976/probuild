---
import { Image } from 'astro:assets';
import SiteLayout from '../../layouts/SiteLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection } from 'astro:content';
import zack from '../../assets/people/zack-pearson.jpg';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  author: { '@type': 'Person', name: post.data.author },
  publisher: { '@id': `${site.url}/#business` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${site.url}/blog/${post.slug}/` },
};
---

<SiteLayout title={`${post.data.title} | Pro Build Digital`} description={post.data.description} ogImage={post.data.image}>
  <article>
    <header class="post-head surface-dark">
      <div class="wrap post-head__inner">
        <a href="/blog/" class="post-head__back">All posts</a>
        <h1 class="display-1 post-head__title">{post.data.title}</h1>
        <p class="lead post-head__lead">{post.data.description}</p>
        <p class="post-head__meta">
          <span>By {post.data.author}</span>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          {post.data.readTime && <span>{post.data.readTime}</span>}
        </p>
      </div>
    </header>

    <div class="section surface-light">
      <div class="wrap post-body">
        <div class="longform">
          <Content />
        </div>

        <aside class="author" aria-label="About the author">
          <Image src={zack} alt="" width={128} height={128} class="author__photo" />
          <div>
            <p class="author__name">{post.data.author}</p>
            <p class="author__text muted">
              I build websites for small businesses in Ashtabula County from Saybrook, Ohio.
              <a href="/about/" class="text-link">More about me</a>
            </p>
          </div>
        </aside>
      </div>
    </div>
  </article>

  <CtaBand />

  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
</SiteLayout>

<style>
  .post-head {
    padding: clamp(40px, 5vw, 72px) 0 clamp(48px, 6vw, 88px);
  }

  .post-head__inner {
    display: grid;
    gap: 22px;
    max-width: calc(52rem + var(--gutter) * 2);
  }

  .post-head__back {
    justify-self: start;
    color: var(--mist);
    font-weight: 600;
    text-decoration: none;
  }

  .post-head__back::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 10px;
    border-left: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
  }

  .post-head__back:hover {
    color: var(--cream);
  }

  .post-head__title {
    color: #f6f3ea;
    font-size: clamp(2.25rem, 1.4rem + 3vw, 3.75rem);
  }

  .post-head__lead {
    color: var(--cream);
  }

  .post-head__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin: 0;
    color: var(--mist);
    font-size: 0.9375rem;
  }

  .post-body {
    display: grid;
    gap: 56px;
    max-width: calc(46rem + var(--gutter) * 2);
  }

  .author {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 18px;
    align-items: center;
    padding-top: 32px;
    border-top: 1px solid var(--rule);
  }

  .author__photo {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
  }

  .author p {
    margin: 0;
  }

  .author__name {
    font-weight: 700;
  }

  .author__text .text-link {
    margin-left: 4px;
    color: var(--ink);
    font-weight: 600;
  }
</style>
