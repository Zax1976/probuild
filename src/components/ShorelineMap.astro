---
// Map of the Lake Erie shore from Painesville to Conneaut, drawn at build time.
// No map library and no JavaScript: the shoreline, county lines and towns come
// from src/data/shoreline.ts and src/data/towns.ts.
//
// variant "band": full-width section with text sitting in the lake (home page).
// variant "inset": framed map inside the page container (town pages).
import { shoreline, boundaries } from '../data/shoreline';
import { towns, home } from '../data/towns';

interface Props {
  variant?: 'band' | 'inset';
  highlight?: string;
}

const { variant = 'band', highlight } = Astro.props;

const W = -81.4;
const E = -80.46;
const S = 41.66;
const N = 42.02;
const kx = Math.cos((((S + N) / 2) * Math.PI) / 180);
const VW = 1400;
const scale = VW / ((E - W) * kx);
const VH = Math.round((N - S) * scale);

const px = (lon: number) => (lon - W) * kx * scale;
const py = (lat: number) => (N - lat) * scale;
const f = (n: number) => Math.round(n * 10) / 10;

// Smooth curve through the shoreline points (Catmull-Rom as cubic Bezier).
const pts = shoreline.map(([lon, lat]) => [px(lon), py(lat)] as [number, number]);
let shore = `M${f(pts[0][0])},${f(pts[0][1])}`;
for (let i = 0; i < pts.length - 1; i++) {
  const p0 = pts[i - 1] ?? pts[i];
  const p1 = pts[i];
  const p2 = pts[i + 1];
  const p3 = pts[i + 2] ?? p2;
  const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
  const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
  shore += ` C${f(c1[0])},${f(c1[1])} ${f(c2[0])},${f(c2[1])} ${f(p2[0])},${f(p2[1])}`;
}
const first = pts[0];
const last = pts[pts.length - 1];
const land = `${shore} L${f(last[0])},${VH + 60} L${f(first[0])},${VH + 60} Z`;

const xLakeAsh = f(px(boundaries.lakeAshtabula));
const xOhPa = f(px(boundaries.ohioPennsylvania));
const yLakeGeauga = f(py(boundaries.lakeGeaugaLat));

// Waterlines: copies of the shore stepped out into the lake, an old engraving technique.
const waterlines = [9, 20, 34, 52, 75, 104, 140].map((d, i) => ({ d, o: [0.55, 0.4, 0.3, 0.22, 0.15, 0.1, 0.06][i] }));

const pct = (x: number, total: number) => `${f((x / total) * 1000) / 10}%`;
const id = `map-${variant}-${(highlight ?? 'all').toLowerCase().replace(/[^a-z]+/g, '-')}`;

const places = towns.map((t) => ({
  ...t,
  x: px(t.lon),
  y: py(t.lat),
  on: highlight ? t.name === highlight : false,
  dim: highlight ? t.name !== highlight : false,
}));
const base = { x: px(home.lon), y: py(home.lat) };

const regions = [
  { name: 'Lake Erie', x: px(-80.82), y: py(41.966), cls: 'map__water' },
  { name: 'Ashtabula County', x: px(-80.66), y: py(41.69), cls: 'map__region' },
  { name: 'Lake County', x: px(-81.17), y: py(41.687), cls: 'map__region' },
  { name: 'Pennsylvania', x: px(-80.49), y: py(41.77), cls: 'map__region map__region--end' },
];
---

<div class:list={['map', `map--${variant}`, highlight && 'map--focus']}>
  {variant === 'band' && <div class="map__text"><slot /></div>}

  <div class="map__canvas">
    <svg viewBox={`0 0 ${VW} ${VH}`} preserveAspectRatio="xMidYMid meet" role="img" aria-labelledby={`${id}-title`}>
      <title id={`${id}-title`}>
        Map of the Lake Erie shore from Painesville to Conneaut, with Saybrook marked as home base
      </title>
      <defs>
        <clipPath id={`${id}-land`}><path d={land}></path></clipPath>
      </defs>

      <rect width={VW} height={VH} class="map__lake"></rect>

      <g class="map__waterlines">
        {waterlines.map((w) => <path d={shore} transform={`translate(0 ${-w.d})`} style={`opacity:${w.o}`}></path>)}
      </g>

      <g clip-path={`url(#${id}-land)`}>
        <rect x="0" y="0" width={VW} height={VH + 60} class="map__land"></rect>
        <rect x="0" y="0" width={xLakeAsh} height={yLakeGeauga} class="map__land map__land--lake"></rect>
        <rect x={xLakeAsh} y="0" width={xOhPa - xLakeAsh} height={VH + 60} class="map__land map__land--home"></rect>
        <rect x={xOhPa} y="0" width={VW - xOhPa} height={VH + 60} class="map__land map__land--pa"></rect>
        <path d={`M${xLakeAsh},0 V${VH + 60}`} class="map__county"></path>
        <path d={`M0,${yLakeGeauga} H${xLakeAsh}`} class="map__county"></path>
        <path d={`M${xOhPa},0 V${VH + 60}`} class="map__state"></path>
      </g>

      <path d={shore} class="map__shore"></path>

      <g class="map__home">
        <circle cx={f(base.x)} cy={f(base.y)} r="26" class="map__ring map__ring--far"></circle>
        <circle cx={f(base.x)} cy={f(base.y)} r="15" class="map__ring"></circle>
        <circle cx={f(base.x)} cy={f(base.y)} r="6.5" class="map__homeDot"></circle>
      </g>

      {
        places.map((p) => (
          <circle
            cx={f(p.x)}
            cy={f(p.y)}
            r={p.on ? 9 : 6}
            class:list={['map__dot', p.on && 'is-on', p.dim && 'is-dim']}
          />
        ))
      }
      {places.filter((p) => p.on).map((p) => <circle cx={f(p.x)} cy={f(p.y)} r="18" class="map__ring" />)}
    </svg>

    <div class="map__labels">
      {
        regions.map((r) => (
          <span class={r.cls} style={`left:${pct(r.x, VW)};top:${pct(r.y, VH)}`} aria-hidden="true">
            {r.name}
          </span>
        ))
      }
      <span class="map__lab map__lab--home lab-d-s lab-m-s" style={`left:${pct(base.x, VW)};top:${pct(base.y, VH)}`}>
        Saybrook<span class="map__labNote">Where I work from</span>
      </span>
      {
        places.map((p) => {
          const cls = ['map__lab', `lab-d-${p.label.d}`, `lab-m-${p.label.m}`, p.on && 'is-on', p.dim && 'is-dim'];
          const style = `left:${pct(p.x, VW)};top:${pct(p.y, VH)}`;
          return p.page && !p.on ? (
            <a href={p.page} class:list={cls} style={style}>
              {p.name}
            </a>
          ) : (
            <span class:list={cls} style={style}>
              {p.name}
            </span>
          );
        })
      }
    </div>
  </div>
</div>

<style>
  .map {
    position: relative;
    --water: #0e1b2e;
    --land: #172a42;
    --land-home: #1d3350;
    --land-lake: #15273e;
    --land-pa: #132338;
  }

  .map__canvas {
    position: relative;
  }

  .map__canvas svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .map--band .map__canvas {
    max-width: 1720px;
    margin-inline: auto;
  }

  @media (min-width: 1721px) {
    .map--band .map__canvas {
      mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
    }
  }

  .map--inset .map__canvas {
    border-radius: 12px;
    overflow: hidden;
  }

  .map__lake {
    fill: var(--water);
  }

  .map__land {
    fill: var(--land);
  }

  .map__land--home {
    fill: var(--land-home);
  }

  .map__land--lake {
    fill: var(--land-lake);
  }

  .map__land--pa {
    fill: var(--land-pa);
  }

  .map__waterlines path {
    fill: none;
    stroke: var(--brass);
    stroke-width: 1.3;
    vector-effect: non-scaling-stroke;
  }

  .map__shore {
    fill: none;
    stroke: var(--brass);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  .map__county {
    fill: none;
    stroke: rgba(234, 230, 218, 0.22);
    stroke-width: 1;
    stroke-dasharray: 5 6;
    vector-effect: non-scaling-stroke;
  }

  .map__state {
    fill: none;
    stroke: rgba(234, 230, 218, 0.34);
    stroke-width: 1.2;
    stroke-dasharray: 14 6 3 6;
    vector-effect: non-scaling-stroke;
  }

  .map__dot {
    fill: var(--cream);
    stroke: var(--water);
    stroke-width: 2;
  }

  .map__dot.is-on {
    fill: var(--brass);
  }

  .map__dot.is-dim {
    opacity: 0.55;
  }

  .map__homeDot {
    fill: var(--brass);
  }

  .map__ring {
    fill: none;
    stroke: var(--brass);
    stroke-width: 1.4;
    vector-effect: non-scaling-stroke;
  }

  .map__ring--far {
    opacity: 0.45;
  }

  /* ---------- Labels (HTML, so they stay readable at any size) ---------- */

  .map__labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .map__lab,
  .map__region,
  .map__water {
    position: absolute;
    white-space: nowrap;
  }

  .map__lab {
    font-family: var(--font-display);
    font-size: clamp(0.75rem, 0.62rem + 0.35vw, 0.9375rem);
    font-weight: 600;
    color: var(--cream);
    line-height: 1.15;
    text-shadow: 0 0 6px var(--water), 0 0 2px var(--water);
    pointer-events: auto;
  }

  a.map__lab {
    text-decoration: underline;
    text-decoration-color: rgba(200, 165, 92, 0.7);
    text-underline-offset: 0.22em;
  }

  a.map__lab:hover {
    color: var(--brass);
  }

  .map__lab.is-on {
    color: var(--brass);
    font-weight: 750;
    font-size: clamp(0.875rem, 0.7rem + 0.5vw, 1.125rem);
  }

  .map__lab.is-dim {
    opacity: 0.7;
  }

  .map__lab--home {
    color: var(--brass);
    font-weight: 750;
    text-align: center;
  }

  .map__labNote {
    display: block;
    font-weight: 500;
    font-size: 0.8em;
    color: var(--cream);
    opacity: 0.85;
  }

  .map__region {
    transform: translate(-50%, -50%);
    font-family: var(--font-text);
    font-style: italic;
    font-size: clamp(0.75rem, 0.6rem + 0.4vw, 1rem);
    color: rgba(234, 230, 218, 0.5);
    letter-spacing: 0.02em;
  }

  .map__region--end {
    transform: translate(-100%, -50%);
  }

  .map__water {
    transform: translate(-50%, -50%);
    font-family: var(--font-text);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.25rem, 0.8rem + 1.6vw, 2.5rem);
    letter-spacing: 0.24em;
    color: rgba(234, 230, 218, 0.45);
  }

  .lab-d-s { transform: translate(-50%, 12px); }
  .lab-d-n { transform: translate(-50%, calc(-100% - 12px)); }
  .lab-d-e { transform: translate(14px, -50%); }
  .lab-d-w { transform: translate(calc(-100% - 14px), -50%); }

  .map__lab--home.lab-d-s { transform: translate(-50%, 20px); }

  @media (max-width: 760px) {
    .lab-m-s { transform: translate(-50%, 7px); }
    .lab-m-n { transform: translate(-50%, calc(-100% - 7px)); }
    .lab-m-e { transform: translate(9px, -50%); }
    .lab-m-w { transform: translate(calc(-100% - 9px), -50%); }
    .map__lab--home.lab-m-s { transform: translate(-50%, 12px); }
    .map__labNote { display: none; }
    .map__region { display: none; }
  }

  /* ---------- Band layout: heading sits in the lake on wide screens ---------- */

  .map--band .map__text {
    padding: var(--section) var(--gutter) 40px;
    max-width: calc(var(--container) + var(--gutter) * 2);
    margin-inline: auto;
  }

  @media (min-width: 1024px) {
    .map--band .map__text {
      position: absolute;
      inset: 0 0 auto 0;
      z-index: 2;
      padding-top: clamp(56px, 6vw, 96px);
      pointer-events: none;
    }

    .map--band .map__text > :global(*) {
      max-width: 30rem;
      pointer-events: auto;
    }
  }
</style>
