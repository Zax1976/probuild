---
// A client site: screenshot in a browser frame, plus business type, town and what was built.
import { Image } from 'astro:assets';
import type { ClientSite } from '../data/work';

interface Props {
  site: ClientSite;
  headingLevel?: 'h2' | 'h3';
  sizes?: string;
}

const { site, headingLevel = 'h3', sizes = '(min-width: 1100px) 600px, (min-width: 900px) 46vw, 92vw' } = Astro.props;
const domain = new URL(site.url).hostname.replace(/^www\./, '');
const Heading = headingLevel;
---

<article class="work-card">
  <figure class="browser work-card__shot">
    <div class="browser__bar" aria-hidden="true">
      <div class="browser__dots"><span></span><span></span><span></span></div>
      <div class="browser__url">{domain}</div>
    </div>
    {
      site.image ? (
        <Image
          src={site.image}
          alt={`The home page of the ${site.name} website`}
          widths={[480, 720, 960, 1389]}
          sizes={sizes}
          loading="lazy"
        />
      ) : (
        <div class="work-card__missing">
          <span class="todo">Add a screenshot to src/assets/work/</span>
        </div>
      )
    }
  </figure>

  <div class="work-card__body">
    <Heading class="display-3">{site.name}</Heading>
    <dl class="facts">
      <div><dt>Business</dt><dd>{site.businessType}</dd></div>
      <div><dt>Where</dt><dd>{site.town}</dd></div>
      <div><dt>What I built</dt><dd>{site.built}</dd></div>
    </dl>
    <a href={site.url} class="text-link work-card__link" rel="noopener" target="_blank">
      Visit {domain}<span class="sr-only"> (opens in a new tab)</span>
    </a>
  </div>
</article>

<style>
  .work-card {
    display: grid;
    gap: 26px;
    align-content: start;
  }

  .work-card__shot {
    margin: 0;
    box-shadow: 0 30px 60px -36px rgba(14, 27, 46, 0.45);
  }

  .work-card__missing {
    aspect-ratio: 1389 / 736;
    display: grid;
    place-items: center;
    background: repeating-linear-gradient(-45deg, #f1f2ee 0 12px, #e9ebe6 12px 24px);
  }

  .work-card__body {
    display: grid;
    gap: 18px;
  }

  .work-card__link {
    justify-self: start;
    font-weight: 600;
  }
</style>
