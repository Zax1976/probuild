---
// Dark top band for inner pages: H1, a lead paragraph, and an optional right column.
interface Props {
  title: string;
  lead?: string;
}

const { title, lead } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<section class="page-hero surface-dark">
  <div class:list={['wrap', 'page-hero__grid', hasAside && 'has-aside']}>
    <div class="page-hero__copy">
      <h1 class="display-1 page-hero__title">{title}</h1>
      {lead && <p class="lead page-hero__lead">{lead}</p>}
      <slot />
    </div>
    {
      hasAside && (
        <div class="page-hero__aside">
          <slot name="aside" />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    padding: clamp(48px, 6vw, 88px) 0 clamp(56px, 7vw, 104px);
  }

  .page-hero__grid {
    display: grid;
    gap: 44px;
    align-items: center;
  }

  @media (min-width: 1000px) {
    .page-hero__grid.has-aside {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: clamp(48px, 6vw, 96px);
    }
  }

  .page-hero__copy {
    display: grid;
    gap: 24px;
    align-content: start;
  }

  .page-hero__title {
    color: #f6f3ea;
    max-width: 14em;
  }

  .page-hero__lead {
    color: var(--cream);
  }

  .page-hero__aside {
    min-width: 0;
  }
</style>
