---
// One package or care plan in full: price, what's included, what isn't, and timing.
import { money, type Plan } from '../data/pricing';

interface Props {
  plan: Plan;
  timingLabel?: string;
}

const { plan, timingLabel = 'How long it takes' } = Astro.props;
const headingId = `plan-${plan.id}`;
---

<article class="plan" aria-labelledby={headingId}>
  <header class="plan__head">
    <h3 id={headingId} class="plan__name">{plan.name}</h3>
    <p class="plan__price">
      <span class="plan__amount">{money(plan.price)}</span>
      <span class="plan__cadence">{plan.cadence}</span>
    </p>
    <p class="plan__summary">{plan.summary}</p>
  </header>

  <div class="plan__lists">
    <div>
      <h4 class="plan__label">Included</h4>
      <ul class="plan__list plan__list--yes">
        {plan.includes.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <div>
      <h4 class="plan__label">Not included</h4>
      <ul class="plan__list plan__list--no">
        {plan.notIncluded.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <div>
      <h4 class="plan__label">{timingLabel}</h4>
      <p class="plan__timing">{plan.timeline}</p>
    </div>
  </div>

  {plan.todo && <span class="todo">{plan.todo}</span>}
</article>

<style>
  .plan {
    display: grid;
    gap: 26px;
    align-content: start;
    padding: clamp(24px, 3vw, 36px);
    border-radius: 10px;
    background: var(--white);
    border: 1px solid var(--rule);
  }

  .plan__head {
    display: grid;
    gap: 12px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--rule);
  }

  .plan__name {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .plan__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    margin: 0;
  }

  .plan__amount {
    font-weight: 800;
    font-stretch: 125%;
    font-size: clamp(2.75rem, 2.2rem + 1.9vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.035em;
    font-variant-numeric: tabular-nums lining-nums;
  }

  .plan__cadence {
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink-2);
  }

  .plan__summary {
    margin: 0;
    font-family: var(--font-text);
    font-size: 1.1875rem;
    line-height: 1.5;
  }

  .plan__lists {
    display: grid;
    gap: 22px;
  }

  .plan__label {
    margin: 0 0 10px;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--ink-2);
  }

  .plan__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 9px;
  }

  .plan__list li {
    position: relative;
    padding-left: 24px;
    font-size: 1rem;
    line-height: 1.45;
  }

  .plan__list--yes li::before {
    content: '';
    position: absolute;
    left: 1px;
    top: 0.32em;
    width: 12px;
    height: 7px;
    border-left: 2px solid var(--brass-ink);
    border-bottom: 2px solid var(--brass-ink);
    transform: rotate(-45deg);
  }

  .plan__list--no li {
    color: var(--ink-2);
  }

  .plan__list--no li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.68em;
    width: 11px;
    height: 2px;
    background: #9aa3ad;
  }

  .plan__timing {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
  }
</style>
