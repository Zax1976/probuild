---
// Home page demo: type a business name and see it on a real-looking sample site.
// Browser tabs switch the business type; words in the name pick a tab on their own.
// Sample copy and stock photos only (see src/assets/samples/CREDITS.md).
// Types, copy, keywords and colors live in src/data/samples.ts.
import { Image } from 'astro:assets';
import { samples, matchOrder } from '../data/samples';

const first = samples[0];

// Client data: copy and keywords only (photos are rendered below).
const data = {
  order: matchOrder,
  samples: samples.map(({ id, nav, line, cta, second, words, phrases }) => ({
    id,
    nav,
    line,
    cta,
    second,
    words,
    phrases: phrases ?? [],
  })),
};

// One CSS block per sample theme, generated from the data file.
const fontVar = (f: 'text' | 'display') => (f === 'text' ? 'var(--font-text)' : 'var(--font-display)');
const themeCss = samples
  .map(({ id, theme: t }) =>
    [
      `.np__browser[data-type="${id}"] .np__site{`,
      `--bg:${t.bg};--ink:${t.ink};--soft:${t.soft};--accent:${t.accent};--on-accent:${t.onAccent};--rule:${t.rule};`,
      `--name-font:${fontVar(t.nameFont)};--name-weight:${t.nameWeight};--name-style:${t.nameItalic ? 'italic' : 'normal'};`,
      `--logo-font:${fontVar(t.logoFont)};--logo-weight:${t.logoWeight};--logo-case:${t.logoCaps ? 'uppercase' : 'none'};`,
      `--logo-track:${t.logoCaps ? '0.16em' : '-0.01em'};--logo-size:${t.logoCaps ? '1em' : '1.25em'};--btn-radius:${t.radius};}`,
      `.np__browser[data-type="${id}"] .np__photo img[data-photo="${id}"]{display:block;animation:np-fade .35s ease both}`,
    ].join(''),
  )
  .join('\n');
---

<div class="np" id="sample-site" data-np>
  <div class="np__field">
    <label for="np-name" class="np__label">Type your business name</label>
    <input
      id="np-name"
      class="np__input"
      type="text"
      maxlength="40"
      autocomplete="organization"
      placeholder="Your business name"
      spellcheck="false"
      aria-describedby="np-hint"
    />
    <p id="np-hint" class="sr-only">The sample site below updates as you type. Use the tabs to change the type of business.</p>
  </div>

  <figure class="np__stage">
    <div class="np__browser" data-type={first.id}>
      <div class="np__chrome">
        <div class="np__tabrow">
          <span class="np__dots" aria-hidden="true"><span></span><span></span><span></span></span>
          <div class="np__tabs" role="radiogroup" aria-label="Type of business">
            {
              samples.map((s, i) => (
                <label class="np__tab" data-tab={s.id}>
                  <input type="radio" name="np-type" value={s.id} checked={i === 0} />
                  <span>{s.tab}</span>
                </label>
              ))
            }
          </div>
          <button type="button" class="np__scroll np__scroll--prev" tabindex="-1" aria-hidden="true">
            <svg viewBox="0 0 8 12"><path d="M6 1L1.5 6 6 11" fill="none" stroke="currentColor" stroke-width="1.6"></path></svg>
          </button>
          <button type="button" class="np__scroll np__scroll--next" tabindex="-1" aria-hidden="true">
            <svg viewBox="0 0 8 12"><path d="M2 1l4.5 5L2 11" fill="none" stroke="currentColor" stroke-width="1.6"></path></svg>
          </button>
        </div>
        <div class="np__bar" aria-hidden="true">
          <span class="np__url">
            <svg viewBox="0 0 10 10"
              ><path
                d="M2.5 4.5V3.2a2.5 2.5 0 015 0v1.3M1.8 4.5h6.4v4.7H1.8z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.1"></path></svg
            >
            <span><span data-slug>yourbusiness</span>.com</span>
          </span>
        </div>
      </div>

      <div class="np__site" aria-hidden="true">
        <div class="np__head">
          <span class="np__logo" data-name>Your Business</span>
          <span class="np__nav">
            {first.nav.map((n, i) => <span data-nav={i}>{n}</span>)}
          </span>
        </div>
        <div class="np__hero">
          <div class="np__copy">
            <span class="np__name" data-name>Your Business</span>
            <span class="np__line" data-line>{first.line}</span>
            <span class="np__actions">
              <span class="np__btn" data-cta>{first.cta}</span>
              <span class="np__second" data-second>{first.second}</span>
            </span>
          </div>
          <div class="np__photo">
            {
              samples.map((s, i) => (
                <Image
                  src={s.photo}
                  alt=""
                  widths={[360, 540, 720]}
                  sizes="(min-width: 1100px) 300px, (min-width: 560px) 45vw, 92vw"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  data-photo={s.id}
                  style={`object-position:${s.position}`}
                />
              ))
            }
          </div>
        </div>
      </div>
    </div>
    <figcaption class="np__caption">
      A quick sample with stock photos. Your site gets your photos and a design of its own.
      <a href="/start/" class="text-link" data-start-link>Start a project</a>
    </figcaption>
  </figure>
</div>

<script type="application/json" id="np-data" set:html={JSON.stringify(data)} />
<Fragment set:html={`<style>${themeCss}</style>`} />

<script>
  type Sample = {
    id: string;
    nav: string[];
    line: string;
    cta: string;
    second: string;
    words: string[];
    phrases: string[];
  };

  const root = document.querySelector<HTMLElement>('[data-np]');
  const raw = document.getElementById('np-data')?.textContent;

  if (root && raw) {
    const { order, samples: list } = JSON.parse(raw) as { order: string[]; samples: Sample[] };
    const byId = Object.fromEntries(list.map((s) => [s.id, s]));
    const wordSets = Object.fromEntries(list.map((s) => [s.id, new Set(s.words)]));

    const input = root.querySelector<HTMLInputElement>('#np-name')!;
    const browser = root.querySelector<HTMLElement>('.np__browser')!;
    const tabs = root.querySelector<HTMLElement>('.np__tabs')!;
    const tabrow = root.querySelector<HTMLElement>('.np__tabrow')!;
    const prev = root.querySelector<HTMLButtonElement>('.np__scroll--prev')!;
    const next = root.querySelector<HTMLButtonElement>('.np__scroll--next')!;
    const startLink = root.querySelector<HTMLAnchorElement>('[data-start-link]')!;
    const all = (sel: string) => root.querySelectorAll<HTMLElement>(sel);
    const radio = (id: string) => root.querySelector<HTMLInputElement>(`input[name="np-type"][value="${id}"]`);

    const normalize = (s: string) =>
      s
        .toLowerCase()
        .normalize('NFKD')
        .replace(/[̀-ͯ]/g, '')
        .replace(/&/g, ' and ')
        .replace(/['’]/g, '')
        .replace(/[^a-z0-9]+/g, ' ')
        .trim();

    const slugify = (s: string) => normalize(s).replace(/\s+/g, '').replace(/^and|and$/g, '').slice(0, 28) || 'yourbusiness';

    // Pick a business type from words in the name. Phrases first, then single words.
    const matchType = (name: string): string | null => {
      const text = ` ${normalize(name)} `;
      const words = text.trim().split(' ');
      for (const id of order) if (byId[id].phrases.some((p) => text.includes(` ${p} `))) return id;
      for (const id of order) if (words.some((w) => wordSets[id].has(w))) return id;
      return null;
    };

    // Load a tab's photo before it is shown.
    const warm = (id: string) => {
      const img = root.querySelector<HTMLImageElement>(`img[data-photo="${id}"]`);
      if (img && img.loading === 'lazy') img.loading = 'eager';
    };

    const updateScroll = () => {
      const max = tabs.scrollWidth - tabs.clientWidth;
      tabrow.classList.toggle('can-prev', tabs.scrollLeft > 2);
      tabrow.classList.toggle('can-next', tabs.scrollLeft < max - 2);
    };

    const showTab = (id: string) => {
      const label = root.querySelector<HTMLElement>(`[data-tab="${id}"]`);
      if (!label) return;
      const l = label.offsetLeft;
      const r = l + label.offsetWidth;
      if (l < tabs.scrollLeft + 28) tabs.scrollTo({ left: l - 28, behavior: 'smooth' });
      else if (r > tabs.scrollLeft + tabs.clientWidth - 36)
        tabs.scrollTo({ left: r - tabs.clientWidth + 36, behavior: 'smooth' });
    };

    const render = () => {
      const typed = input.value.trim().replace(/\s+/g, ' ');
      const name = typed || 'Your Business';
      const type = root.querySelector<HTMLInputElement>('input[name="np-type"]:checked')?.value ?? list[0].id;
      const s = byId[type];

      warm(type);
      browser.dataset.type = type;
      browser.dataset.length = name.length > 26 ? 'long' : name.length > 16 ? 'mid' : 'short';
      all('[data-name]').forEach((el) => (el.textContent = name));
      all('[data-slug]').forEach((el) => (el.textContent = slugify(name)));
      all('[data-nav]').forEach((el) => (el.textContent = s.nav[Number(el.dataset.nav)]));
      all('[data-line]').forEach((el) => (el.textContent = s.line));
      all('[data-cta]').forEach((el) => (el.textContent = s.cta));
      all('[data-second]').forEach((el) => (el.textContent = s.second));

      startLink.href = typed ? `/start/?business=${encodeURIComponent(typed)}` : '/start/';
      startLink.textContent = typed ? `Start a project for ${typed}` : 'Start a project';
    };

    // Auto-pick only when the matched type changes, so a tab the visitor chose by
    // hand is not overridden while they keep typing the same name.
    let lastMatch: string | null = null;
    input.addEventListener('input', () => {
      const match = matchType(input.value);
      if (match && match !== lastMatch) {
        const r = radio(match);
        if (r && !r.checked) {
          r.checked = true;
          showTab(match);
        }
      }
      lastMatch = match;
      render();
    });

    root.querySelectorAll<HTMLInputElement>('input[name="np-type"]').forEach((r) => {
      r.addEventListener('change', () => {
        showTab(r.value);
        render();
      });
      const label = r.closest('label')!;
      label.addEventListener('pointerenter', () => warm(r.value));
      r.addEventListener('focus', () => warm(r.value));
    });

    prev.addEventListener('click', () => tabs.scrollBy({ left: -200, behavior: 'smooth' }));
    next.addEventListener('click', () => tabs.scrollBy({ left: 200, behavior: 'smooth' }));
    tabs.addEventListener('scroll', updateScroll, { passive: true });
    new ResizeObserver(updateScroll).observe(tabs);

    // "See a sample site with your business name" links jump here and put the cursor in the box.
    document.querySelectorAll<HTMLAnchorElement>('a[href="#sample-site"]').forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        // Only scroll when part of the sample is off screen (on wide screens it sits beside the headline).
        const box = root.getBoundingClientRect();
        if (box.top < 0 || box.bottom > window.innerHeight) {
          const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          root.scrollIntoView({ behavior: still ? 'auto' : 'smooth', block: 'start' });
        }
        input.focus({ preventScroll: true });
      });
    });

    updateScroll();
    render();
  }
</script>

<style>
  .np {
    display: grid;
    gap: 20px;
    min-width: 0;
    scroll-margin-top: 24px;
  }

  .np > * {
    min-width: 0;
  }

  /* ---------- Name field ---------- */

  .np__label {
    display: block;
    margin-bottom: 8px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--cream);
  }

  .np__input {
    width: 100%;
    min-height: 54px;
    padding: 12px 16px;
    border-radius: 8px;
    border: 1px solid rgba(234, 230, 218, 0.28);
    background: var(--lake-deep);
    color: var(--cream);
    font: inherit;
    font-size: 1.125rem;
    font-weight: 550;
    transition: border-color 0.15s var(--ease), box-shadow 0.15s var(--ease);
  }

  .np__input::placeholder {
    color: var(--mist);
    font-weight: 400;
  }

  .np__input:focus {
    outline: none;
    border-color: var(--brass);
    box-shadow: 0 0 0 3px rgba(200, 165, 92, 0.35);
  }

  /* ---------- Browser ---------- */

  .np__stage {
    display: grid;
    gap: 20px;
    margin: 0;
  }

  .np__browser {
    border-radius: 12px;
    overflow: hidden;
    background: #ffffff;
    box-shadow:
      0 40px 80px -28px rgba(0, 0, 0, 0.6),
      0 12px 24px -12px rgba(0, 0, 0, 0.35);
  }

  .np__chrome {
    background: #e3e5e0;
  }

  .np__tabrow {
    position: relative;
    display: flex;
    align-items: flex-end;
    padding: 8px 0 0 10px;
  }

  .np__dots {
    display: flex;
    gap: 6px;
    align-self: center;
    padding: 0 10px 6px 4px;
    flex: none;
  }

  .np__dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #c4c8c0;
  }

  .np__tabs {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    flex: 1;
    min-width: 0;
    padding-right: 10px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .np__tabs::-webkit-scrollbar {
    display: none;
  }

  .can-prev .np__tabs {
    mask-image: linear-gradient(to right, transparent 0, #000 36px);
  }

  .can-next .np__tabs {
    mask-image: linear-gradient(to left, transparent 0, #000 44px);
  }

  .can-prev.can-next .np__tabs {
    mask-image: linear-gradient(to right, transparent 0, #000 36px, #000 calc(100% - 44px), transparent 100%);
  }

  .np__tab {
    position: relative;
    flex: none;
  }

  .np__tab input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .np__tab span {
    display: block;
    padding: 8px 14px 9px;
    border-radius: 8px 8px 0 0;
    color: #4a5565;
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
    transition: background-color 0.15s var(--ease), color 0.15s var(--ease);
  }

  .np__tab:hover span {
    background: rgba(255, 255, 255, 0.45);
    color: var(--ink);
  }

  .np__tab input:checked + span {
    background: #f7f8f5;
    color: var(--ink);
  }

  .np__tab input:focus-visible + span {
    outline: 2px solid var(--lake);
    outline-offset: -3px;
  }

  .np__scroll {
    position: absolute;
    bottom: 4px;
    display: none;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 0;
    border-radius: 50%;
    background: #f7f8f5;
    color: var(--ink);
    cursor: pointer;
    box-shadow: 0 1px 3px rgba(14, 27, 46, 0.25);
  }

  .np__scroll svg {
    width: 8px;
    height: 12px;
  }

  .np__scroll--prev {
    left: 64px;
  }

  .np__scroll--next {
    right: 8px;
  }

  .can-prev .np__scroll--prev,
  .can-next .np__scroll--next {
    display: grid;
  }

  .np__bar {
    display: flex;
    align-items: center;
    height: 40px;
    padding: 0 12px;
    background: #f7f8f5;
    border-bottom: 1px solid #dfe2dc;
  }

  .np__url {
    display: flex;
    align-items: center;
    gap: 7px;
    width: 100%;
    height: 26px;
    padding: 0 12px;
    border-radius: 13px;
    background: #ebede8;
    color: #4a5565;
    font-size: 0.78rem;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
  }

  .np__url svg {
    width: 10px;
    height: 10px;
    flex: none;
  }

  /* ---------- Sample site (colors come from src/data/samples.ts) ---------- */

  .np__site {
    background: var(--bg);
    color: var(--ink);
    font-size: clamp(10.5px, 0.45rem + 0.42vw, 13px);
    transition: background-color 0.3s var(--ease), color 0.3s var(--ease);
  }

  .np__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5em;
    padding: 1.15em 2em;
    border-bottom: 1px solid var(--rule);
  }

  .np__logo {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--logo-font);
    font-weight: var(--logo-weight);
    font-size: var(--logo-size);
    text-transform: var(--logo-case);
    letter-spacing: var(--logo-track);
  }

  .np__nav {
    display: flex;
    gap: 1.6em;
    flex: none;
    font-family: var(--font-display);
    font-size: 0.95em;
    font-weight: 550;
    color: var(--soft);
  }

  .np__hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    min-height: 23em;
  }

  .np__copy {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1.1em;
    padding: 2.4em 2em;
  }

  .np__name {
    font-family: var(--name-font);
    font-weight: var(--name-weight);
    font-style: var(--name-style);
    letter-spacing: -0.02em;
    font-size: 2.85em;
    line-height: 1.02;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  [data-length='mid'] .np__name {
    font-size: 2.35em;
  }

  [data-length='long'] .np__name {
    font-size: 1.9em;
  }

  .np__line {
    max-width: 22em;
    font-family: var(--font-display);
    font-size: 1.05em;
    line-height: 1.5;
    color: var(--soft);
  }

  .np__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8em 1.3em;
    margin-top: 0.4em;
  }

  .np__btn {
    padding: 0.85em 1.35em;
    border-radius: var(--btn-radius);
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-display);
    font-size: 0.95em;
    font-weight: 700;
    transition: background-color 0.3s var(--ease), color 0.3s var(--ease);
  }

  .np__second {
    font-family: var(--font-display);
    font-size: 0.95em;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-color: color-mix(in srgb, var(--ink) 35%, transparent);
  }

  .np__photo {
    position: relative;
    overflow: hidden;
    background: var(--rule);
  }

  .np__photo img {
    position: absolute;
    inset: 0;
    display: none;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Used by the generated theme rules: the shown photo fades in when the tab changes. */
  @keyframes np-fade {
    from {
      opacity: 0;
    }
  }

  .np__caption {
    margin: 0;
    color: var(--mist);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .np__caption .text-link {
    display: inline-block;
    margin-left: 4px;
    color: var(--cream);
    font-weight: 600;
  }

  @media (max-width: 560px) {
    .np__nav span:nth-child(n + 2) {
      display: none;
    }

    .np__hero {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .np__photo {
      order: -1;
      aspect-ratio: 16 / 9;
    }

    .np__copy {
      padding: 1.8em 1.6em 2em;
    }
  }
</style>
