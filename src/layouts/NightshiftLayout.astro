---
// Nightshift (navy + brass) layout for the bot-first pages.
// Other pages keep Header/Footer via PageLayout until they are restyled.
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const { title, description, keywords, ogImage, canonicalUrl } = Astro.props;
const currentYear = new Date().getFullYear();

const navLinks = [
  { href: '/services', label: 'The Build Bot' },
  { href: '/#how', label: 'How it works' },
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  ogImage={ogImage}
  canonicalUrl={canonicalUrl}
>
  <div class="ns-page bg-night text-cream min-h-screen">
    <!-- Skip Link for Accessibility -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- Nav -->
    <nav class="sticky top-0 z-50 border-b border-cream/10 bg-[rgba(14,27,46,0.92)] backdrop-blur-lg">
      <div class="max-w-[1312px] mx-auto px-6 md:px-16 h-20 flex items-center justify-between">
        <a href="/" class="ns-wordmark" aria-label="Pro Build Digital home">
          PRO BUILD<br /><span>DIGITAL</span>
        </a>

        <div class="hidden lg:flex items-center gap-8 text-[15px] font-semibold text-mist">
          {navLinks.map((link) => (
            <a href={link.href} class="text-mist transition-colors">{link.label}</a>
          ))}
          <!-- TODO(owner): repoint to websites subdomain when it exists -->
          <a href="/#websites" class="text-brass transition-colors">Need a website?</a>
          <a href="/#demo" class="btn-brass px-6 py-3 text-sm">Book a demo</a>
        </div>

        <button
          class="lg:hidden flex flex-col gap-1.5 p-2 min-w-11 min-h-11 items-center justify-center"
          id="ns-nav-toggle"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="ns-mobile-menu"
        >
          <span class="w-6 h-0.5 bg-cream rounded-full"></span>
          <span class="w-6 h-0.5 bg-cream rounded-full"></span>
          <span class="w-6 h-0.5 bg-cream rounded-full"></span>
        </button>
      </div>
    </nav>

    <!-- Mobile Menu Overlay -->
    <div id="ns-menu-overlay" class="fixed inset-0 bg-black/50 z-40 hidden lg:hidden opacity-0 transition-opacity duration-300"></div>

    <!-- Mobile Menu Panel -->
    <div id="ns-mobile-menu" class="fixed top-0 right-0 h-full w-72 bg-night-deep border-l border-cream/10 z-50 transform translate-x-full transition-transform duration-300 lg:hidden">
      <div class="p-6">
        <div class="flex items-center justify-between mb-8">
          <span class="font-wordmark font-extrabold text-cream">Menu</span>
          <button id="ns-menu-close" class="text-mist hover:text-cream p-2 min-w-11 min-h-11" aria-label="Close menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        <ul class="space-y-2">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="ns-mobile-link block px-4 py-3 rounded-lg text-base font-medium text-mist hover:text-cream hover:bg-white/5 transition-all">
                {link.label}
              </a>
            </li>
          ))}
          <li>
            <!-- TODO(owner): repoint to websites subdomain when it exists -->
            <a href="/#websites" class="ns-mobile-link block px-4 py-3 rounded-lg text-base font-medium text-brass hover:bg-white/5 transition-all">
              Need a website?
            </a>
          </li>
        </ul>
        <div class="mt-8 pt-6 border-t border-cream/10">
          <a href="/#demo" class="ns-mobile-link btn-brass block text-center">Book a demo</a>
        </div>
      </div>
    </div>

    <main id="main-content">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-night-deep border-t border-cream/10 text-faint text-[14.5px]">
      <div class="max-w-[1312px] mx-auto px-6 md:px-16 pt-13 pb-9">
        <div class="flex flex-col md:flex-row justify-between flex-wrap gap-8">
          <div class="max-w-[340px]">
            <a href="/" class="ns-wordmark">PRO BUILD<br /><span>DIGITAL</span></a>
            <p class="mt-4 leading-relaxed text-mist">
              Home of the Build Bot, an assistant your customers will know as yours.
            </p>
          </div>
          <div class="flex flex-col gap-1 lg:gap-2.5">
            <div class="text-cream font-bold mb-0.5">Explore</div>
            <a href="/services" class="flex items-center min-h-11 lg:min-h-0 text-mist transition-colors">The Build Bot</a>
            <a href="/#how" class="flex items-center min-h-11 lg:min-h-0 text-mist transition-colors">How it works</a>
            <!-- TODO(owner): repoint to websites subdomain when it exists -->
            <a href="/#websites" class="flex items-center min-h-11 lg:min-h-0 text-mist transition-colors">Websites &amp; invoicing &rarr;</a>
          </div>
          <div class="flex flex-col gap-1 lg:gap-2.5">
            <div class="text-cream font-bold mb-0.5">Contact</div>
            <a href="mailto:zack.pearson@probuilddigital.com" class="flex items-center min-h-11 lg:min-h-0 text-mist transition-colors">zack.pearson@probuilddigital.com</a>
            <a href="tel:+16144038014" class="flex items-center min-h-11 lg:min-h-0 text-mist transition-colors">(614) 403-8014</a>
          </div>
        </div>
        <div class="border-t border-cream/10 mt-9 pt-5 text-[13px] flex flex-col sm:flex-row justify-between gap-2.5">
          <span>&copy; {currentYear} Pro Build Digital. All rights reserved.</span>
          <span class="flex items-center gap-4.5">
            <a href="/privacy-policy" class="inline-flex items-center min-h-11 min-w-11 lg:min-h-0 lg:min-w-0 text-faint transition-colors">Privacy</a>
            <a href="/terms-of-service" class="inline-flex items-center min-h-11 min-w-11 lg:min-h-0 lg:min-w-0 text-faint transition-colors">Terms</a>
            <a href="/sms-consent" class="inline-flex items-center min-h-11 lg:min-h-0 text-faint transition-colors">SMS notifications</a>
          </span>
        </div>
      </div>
    </footer>
  </div>

  <script>
    // Mobile navigation toggle (same pattern as Header.astro)
    const navToggle = document.getElementById('ns-nav-toggle');
    const menuOverlay = document.getElementById('ns-menu-overlay');
    const menuPanel = document.getElementById('ns-mobile-menu');
    const menuClose = document.getElementById('ns-menu-close');

    function openMenu() {
      menuOverlay?.classList.remove('hidden');
      setTimeout(() => {
        menuOverlay?.classList.remove('opacity-0');
        menuPanel?.classList.remove('translate-x-full');
      }, 10);
      navToggle?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      menuOverlay?.classList.add('opacity-0');
      menuPanel?.classList.add('translate-x-full');
      navToggle?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      setTimeout(() => {
        menuOverlay?.classList.add('hidden');
      }, 300);
    }

    navToggle?.addEventListener('click', openMenu);
    menuClose?.addEventListener('click', closeMenu);
    menuOverlay?.addEventListener('click', closeMenu);
    document.querySelectorAll('.ns-mobile-link').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
    });
  </script>
</BaseLayout>
